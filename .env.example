# Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Sirve la "publishable key" nueva (sb_publishable_…) o la "anon key" clásica (eyJ…).
# Nunca uses acá la secret / service_role key: queda expuesta en el navegador.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
